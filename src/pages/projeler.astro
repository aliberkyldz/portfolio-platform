---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { projects } from "@/data/projects";
---

<BaseLayout title="Projeler" description="DevOps ve SRE case study'leri.">
  <PageHeader
    eyebrow="Projeler / Case Study"
    title="Sonuç kadar karar sürecini de gösteren çalışmalar."
    intro="Her çalışma; problem, kısıtlar, mimari kararlar, güvenlik yaklaşımı, maliyet ve öğrenimler üzerinden anlatılır."
  />
  <section class="container-shell grid gap-6 pb-16">
    {
      projects.map((project, index) => (
        <article class="surface grid gap-8 rounded-2xl p-7 md:grid-cols-[5rem_1fr_.8fr] md:p-9">
          <span class="font-mono text-3xl text-slate-700">0{index + 1}</span>
          <div>
            <p class="eyebrow">{project.status}</p>
            <h2 class="mt-4 text-2xl font-semibold text-white">
              {project.title}
            </h2>
            <p class="mt-3 leading-7 text-slate-400">{project.description}</p>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-wider text-slate-500 uppercase">
              Amaç / Etki
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              {project.impact}
            </p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="rounded bg-white/5 px-2 py-1 font-mono text-xs text-teal-200">
                  {tag}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
