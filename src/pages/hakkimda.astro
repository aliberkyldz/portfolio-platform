---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { certifications, experience, site } from "@/data/site";
---

<BaseLayout
  title="Hakkımda"
  description="Ali Berk Yıldız'ın DevOps ve SRE yaklaşımı."
>
  <PageHeader
    eyebrow="Hakkımda"
    title="Karmaşıklığı azaltan, güvenilirliği görünür kılan sistemler."
    intro="DevOps ve SRE disiplinlerini yalnızca araç seti değil, ürün ekiplerinin daha güvenli ve hızlı hareket etmesini sağlayan bir çalışma biçimi olarak görüyorum."
  />
  <section class="container-shell grid gap-10 pb-16 lg:grid-cols-[1fr_.7fr]">
    <div class="prose-copy text-lg">
      <p>
        Ankara’da yaşayan ve Akbank bünyesinde çalışan bir Site Reliability
        Engineer olarak; altyapıyı kodla yönetme, teslimat süreçlerini
        otomatikleştirme, gözlemlenebilirlik ve operasyonel güvenilirlik
        alanlarına odaklanıyorum.
      </p>
      <p>
        Bir çözümü değerlendirirken yalnızca “çalışıyor mu?” sorusunu değil;
        maliyeti öngörülebilir mi, hata anında anlaşılır mı, güvenli biçimde
        değiştirilebilir mi ve ekip tarafından sürdürülebilir mi sorularını da
        soruyorum.
      </p>
      <p>
        Bu site de aynı yaklaşımın uygulamalı bir örneği: kaynak kodundan
        altyapısına, güvenlik kontrollerinden operasyonel dokümantasyonuna kadar
        incelenebilir bir sistem.
      </p>
      <p>
        {site.education} geçmişimin yanında, profesyonel çalışma yetkinliğinde İngilizce
        kullanıyorum.
      </p>
    </div>
    <div class="surface rounded-2xl p-7">
      <p class="eyebrow">Çalışma prensipleri</p>
      <ol class="mt-7 space-y-5">
        <li class="border-l border-teal-300/40 pl-5">
          <strong class="text-white">Ölçmeden optimize etme.</strong><p
            class="mt-1 text-sm text-slate-400"
          >
            Kararlar metrik, SLO ve gerçek kullanım verisine dayanır.
          </p>
        </li>
        <li class="border-l border-teal-300/40 pl-5">
          <strong class="text-white">Tekrarlanan işi otomatikleştir.</strong><p
            class="mt-1 text-sm text-slate-400"
          >
            İnsan odağını muhakeme gerektiren işe ayır.
          </p>
        </li>
        <li class="border-l border-teal-300/40 pl-5">
          <strong class="text-white">Basitliği koru.</strong><p
            class="mt-1 text-sm text-slate-400"
          >
            Her yeni bileşen işletim yükünü hak etmeli.
          </p>
        </li>
      </ol>
    </div>
  </section>
  <section class="container-shell pb-16">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">Deneyim</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">
          Sistem mühendisliğinden SRE’ye
        </h2>
      </div>
      <p class="text-sm text-slate-500">2017 — Günümüz</p>
    </div>
    <ol class="mt-8 border-l border-white/10">
      {
        experience.map((item) => (
          <li class="relative pb-9 pl-8 last:pb-0">
            <span class="absolute top-2 -left-[5px] h-2.5 w-2.5 rounded-full bg-teal-300 shadow-[0_0_10px_#5eead4]" />
            <div class="surface rounded-2xl p-6">
              <div class="flex flex-col justify-between gap-2 sm:flex-row">
                <div>
                  <h3 class="text-lg font-semibold text-white">{item.role}</h3>
                  <p class="mt-1 text-teal-200">{item.company}</p>
                </div>
                <div class="text-sm text-slate-500 sm:text-right">
                  <p>{item.period}</p>
                  <p class="mt-1">{item.location}</p>
                </div>
              </div>
              {item.stack && (
                <p class="mt-5 border-t border-white/8 pt-4 font-mono text-xs leading-6 text-slate-400">
                  {item.stack}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
  <section class="container-shell pb-16">
    <p class="eyebrow">Sertifikalar</p>
    <div class="mt-7 grid gap-5 md:grid-cols-3">
      {
        certifications.map((certificate) => (
          <article class="surface rounded-2xl p-6">
            <p class="font-mono text-xs text-teal-300">{certificate.issued}</p>
            <h2 class="mt-4 text-lg font-semibold text-white">
              {certificate.name}
            </h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              {certificate.issuer}
            </p>
            {certificate.expires && (
              <p class="mt-3 text-xs text-slate-500">
                Geçerlilik: {certificate.expires}
              </p>
            )}
            {certificate.credential && (
              <a
                class="mt-5 inline-block text-sm font-semibold text-teal-300 hover:text-teal-200"
                href={certificate.credential}
                target="_blank"
                rel="noreferrer"
              >
                Yeterlilik belgesi ↗
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>
  <section class="container-shell pb-16">
    <div class="surface rounded-2xl p-8">
      <p class="eyebrow">Eğitim</p>
      <h2 class="mt-5 text-xl font-semibold text-white">
        Abant İzzet Baysal Üniversitesi
      </h2>
      <p class="mt-2 text-slate-300">
        Elektrik ve Elektronik Mühendisliği · Lisans
      </p>
      <p class="mt-3 font-mono text-sm text-slate-500">2012 — 2017</p>
    </div>
  </section>
</BaseLayout>
